                    "tooltip": "API Call URL Parameters",
                    "type": "json",
                    "visible": true,
                    "editable": true,
                    "required": false
                },
                {
                    "title": "Payload",
                    "name": "payload",
                    "description": "API Call Payload",
                    "tooltip": "API Call Payload",
                    "type": "json",
