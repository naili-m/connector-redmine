                "visible": true,
                "value": "https://redmine.com",
                "tooltip": "Specify Redmine URL."
            },
            {
                "title": "API Key",
                "description": "Specify Redmine API key",
                "required": true,
                "editable": true,
                "visible": true,
                "type": "password",
                "name": "api_key",
                "tooltip": "Specify Redmine API key"
            },
            {
                "title": "Verify SSL",
                "description": "Specifies whether the SSL certificate for the server is to be verified. By default, this option is set to True.",
                "name": "verify_ssl",
                "type": "checkbox",
                "required": false,
                "editable": true,
                "visible": true,
                "value": true,
                "tooltip": "Specifies whether the SSL certificate for the server is to be verified. By default, this option is set to True."
            }
        ]
    },
    "operations": [
        {
            "title": "API Call",
            "description": "Run API Call",
            "tooltip": "",
